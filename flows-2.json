        "tab": "56aa36f31c02708f",
        "name": "Rooms List Table",
        "order": 2,
        "width": "12",
        "height": 0,
        "format": "<!--\n// =========================================================================\n// 1. VISUEL : STRUCTURE HTML DU TABLEAU DE LISTE DES PIECES\n// =========================================================================\n-->\n<h3 style=\"text-align:center;\">Nom des pièces</h3>\n\n<table id=\"rooms_list\">\n    <tbody>\n        <tr>\n            <th class=\"center\" style=\"width:5%\">#</th>\n            <th class=\"center\" style=\"width:75%\">Pièce</th>\n            <th class=\"center\" style=\"width:20%\">Actions</th>\n        </tr>\n    </tbody>\n</table>\n\n<!-- The Modal -->\n<div id=\"rooms_list_modal\" class=\"modal\">\n    <!-- Modal content -->\n    <div class=\"modal-content\">\n        <div class=\"modal-header\">\n            <h2 id=\"rooms_list_modal_title\" style=\"margin: auto;\"></h2>\n        </div>\n        <div class=\"modal-body\">\n            <p id=\"rooms_list_modal_info\"></p>\n            <p>Voulez-vous continuer ?</p>\n        </div>\n        <div class=\"modal-footer\">\n            <div class=\"d-grid gap-2 col-12 mx-auto\">\n                <button type=\"button\" class=\"btn btn-danger btn-lg\" onclick=\"roomsListModalValidate()\">Valider</button>\n                <button type=\"button\" class=\"btn btn-secondary btn-lg\" onclick=\"roomsListModalCancelled()\">Annuler</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n// =========================================================================\n// 2. VARIABLES ET CONFIGURATION GLOBALE DU TABLEAU DES PIECES\n// =========================================================================\n    var table = document.getElementById('rooms_list');\n    var messageRooms;\n    var rooms_list_modal = document.getElementById('rooms_list_modal');\n    var rowRoomsList;\n    var orderRoomsList = [];\n\n// =========================================================================\n// 3. CONSTRUIRE LE TABLEAU : RECEPTION ET TRAITEMENT DES LIGNES DYNAMIQUES\n// =========================================================================\n    $node.on(\"update-value\", function(evt, data) {\n        var dat = data.msg.payload;\n        clearRoomsList();\n\n        if (data.msg.topic === \"load_rooms_list\") {\n            dat.forEach(function(obj) {\n                var tr = document.createElement('tr');\n                tr.setAttribute('name', 'room'); \n                tr.setAttribute('id', obj._id); \n                tr.setAttribute('class', 'dragline'); \n                tr.setAttribute('draggable', 'true'); \n                tr.setAttribute('ondragstart', 'dragstartRoomsList()'); \n                tr.setAttribute('ondragend', 'dragendRoomsList()'); \n                tr.setAttribute('ondragover', 'dragoverRoomsList()'); \n                // MODIFICATION : Crayon changé en disquette (ti-save), couleur modifiée en btn-dark et ti-trash reste en btn-danger\n                tr.innerHTML =\n                    '<td name=\"number\" class=\"center\">' + obj.number + '</td>' +\n                    '<td class=\"center\"><input name=\"name\" class=\"fullDiv center\" value=\"' + obj.name + '\" autocomplete=\"off\" placeholder=\"Nom de la salle\"></input></td>' +\n                    '<td class=\"center\">' +\n                    '<button class=\"btn btn-dark\" onclick=\"saveRoom(this, \\'' + obj._id + '\\')\"><i class=\"nav-hdr-btn ti-save fa-lg\"></i></button>' +\n                    '<button class=\"btn btn-danger\" onclick=\"deleteRoom(\\'' + obj._id + '\\')\"><i class=\"nav-hdr-btn ti-trash fa-lg\"></i></button>' +\n                    '</td>';\n                table.appendChild(tr);\n            });\n\n            var tr = document.createElement('tr');\n            tr.setAttribute('name', 'room'); \n            tr.setAttribute('id', \"newAction\"); \n            // MODIFICATION : Bouton d'ajout passé en btn-dark (ti-save) et bouton d'annulation passé en btn-warning (ti-reload)\n            tr.innerHTML =\n                '<td name=\"number\" class=\"center\">' + (dat.length+1) + '</td>' +\n                '<td class=\"center\"><input name=\"name\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Nom de la salle\"></input></td>' +\n                '<td class=\"center\">' +\n                '<button class=\"btn btn-dark\" onclick=\"saveRoom(this, \\'new\\')\"><i class=\"nav-hdr-btn ti-save fa-lg\"></i></button>' +\n                '<button class=\"btn btn-warning\" onclick=\"cancelAddRoom()\"><i class=\"nav-hdr-btn ti-reload fa-lg\"></i></button>' +\n                '</td>';\n            table.appendChild(tr);\n            keeporderRoomsList();\n        }\n    });\n\n// =========================================================================\n// 4. NETTOYAGE : SUPPRESSION DE TOUTES LES LIGNES VISIBLES\n// =========================================================================\n    function clearRoomsList() {\n        var rooms = document.querySelectorAll('[name = \"room\"]');\n        rooms.forEach(room => {\n            room.remove();\n        });\n    }\n\n// =========================================================================\n// 5. ACTIONS DU FORMULAIRE : CONFIGURATIONS SANS DEPENDANCE JREQUY\n// =========================================================================\n    function saveRoom(data, id) {\n        var row = data.closest(\"tr\"); \n        var inputName = row.querySelector('[name=\"name\"]');\n        var name = inputName ? inputName.value : \"\";\n        var numberElem = row.querySelector('[name=\"number\"]');\n        var number = numberElem ? numberElem.textContent : \"\";\n        \n        var msg = {\n            \"topic\": \"save_room\",\n            \"payload\": {\n                \"_id\": id,\n                \"name\": name,\n                \"number\": number,\n            }\n        }\n        $node.trigger('send', msg);\n    }\n\n    function deleteRoom(data) {\n        rooms_list_modal.style.display = \"block\";\n        document.getElementById('rooms_list_modal_title').innerHTML = \"MISE EN GARDE\";\n        document.getElementById('rooms_list_modal_info').innerHTML = \"Cette action est irréversible. La salle sera définitivement supprimée...\";\n        messageRooms = {\n            \"topic\": \"delete_room\",\n            \"payload\": {\n                \"_id\" : data,\n                \"new_order\": orderRoomsList\n            }\n        }\n    }\n\n    function cancelAddRoom() {\n        var msg = {\n            \"topic\": \"reload_room\",\n            \"payload\": {},\n        }\n        $node.trigger('send', msg);\n    }\n\n// =========================================================================\n// 6. GESTION DU DRAG & DROP : TRI ET REORDONNANCEMENT DES LIGNES\n// =========================================================================\n    function dragstartRoomsList() {\n        rowRoomsList = event.target;\n    }\n\n    function dragoverRoomsList() {\n        var e = event;\n        var list = [];\n        e.preventDefault();\n        let children = Array.from(e.target.parentNode.parentNode.children);\n        if(children.indexOf(e.target.parentNode)>children.indexOf(rowRoomsList)) {\n            try {\n                e.target.parentNode.after(rowRoomsList);\n            } catch (e) {\n                return;\n            }\n        }\n        else {\n            e.target.parentNode.before(rowRoomsList);\n        }\n    }\n\n    function dragendRoomsList() {\n        keeporderRoomsList();\n        var msg = {\n            \"topic\": \"new_order_room\",\n            \"payload\": {\n                \"new_order\": orderRoomsList\n            }\n        }\n        $node.trigger('send', msg);\n    }\n\n    function keeporderRoomsList() {\n        orderRoomsList = [];\n        var rows = document.querySelectorAll(\"#rooms_list tr.dragline\");\n        for (var i = 0; i < rows.length; i++) {\n            orderRoomsList.push(rows[i].id);\n        }\n    }\n\n    function roomsListModalValidate() {\n        $node.trigger('send', messageRooms);\n        rooms_list_modal.style.display = \"none\";\n    }\n\n    function roomsListModalCancelled() {\n        rooms_list_modal.style.display = \"none\";\n    }\n\n    function showDetails(sel) {\n        var selected = sel.options[sel.selectedIndex].value;\n        \n        var details = sel.querySelectorAll('.detail');\n        for (var i = 0; i < details.length; i++) {\n            details[i].style.display = 'none';\n        }\n        \n        var targetDetail = sel.querySelector('[name=\"' + selected + '\"]');\n        if (targetDetail) {\n            targetDetail.style.display = 'block';\n        }\n    }\n</script>",
