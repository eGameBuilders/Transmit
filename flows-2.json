    {
        "id": "abbb2e4afe32cdd3",
        "type": "ur_template",
        "z": "b87f87d6b87a22c5",
        "g": "0ea444d24736682e",
        "tab": "716f2cb0ce20cd75",
        "name": "Triggers List Table",
        "order": 2,
        "width": "12",
        "height": 0,
        "format": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\">\n\n<table id=\"triggers_list\">\n    <tbody>\n        <tr>\n            <th id=\"trigger\" class=\"center\" style=\"width:20%\">Nom</th>\n            <th id=\"room\" class=\"center\" style=\"width:10%\">Pièce</th>\n            <th id=\"type\" class=\"center\" style=\"width:10%\">Type</th>\n            <th id=\"system\" class=\"center\" style=\"width:10%\">Système</th>\n            <th id=\"device\" class=\"center\" style=\"width:15%\">Device</th>\n            <th id=\"entry\" class=\"center\" style=\"width:15%\">Entrée</th>\n            <th class=\"center\" style=\"width:20%\">Actions</th>\n        </tr>\n    </tbody>\n</table>\n\n<!-- The Modal -->\n<div id=\"triggers_list_modal\" class=\"modal\">\n    <!-- Modal content -->\n    <div class=\"modal-content\">\n        <div class=\"modal-header\">\n            <h2 id=\"triggers_list_modal_title\" style=\"margin: auto;\"></h2>\n        </div>\n        <div class=\"modal-body\">\n            <p id=\"triggers_list_modal_info\"></p>\n            <p>Voulez-vous continuer ?</p>\n        </div>\n        <div class=\"modal-footer\">\n            <div class=\"d-grid gap-2 col-12 mx-auto\">\n                <button type=\"button\" class=\"btn btn-danger btn-lg\" onclick=\"triggersListModalValidate()\">Valider</button>\n                <button type=\"button\" class=\"btn btn-secondary btn-lg\" onclick=\"triggersListModalCancelled()\">Annuler</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n    //GLOBALS VARIABLES\n    var MCP23017_datas;\n    var KMS868_datas;\n    var ESP32_datas;\n    var option_Selected;\n\n    //GLOBALS FUNCTIONS\n\n    //CREATE TABLE\n    $node.on(\"update-value\", function(evt, data) {\n        var dat = data.msg.payload;\n        //clear table\n        clearTriggersList();\n        //table\n        var table = document.getElementById('triggers_list');\n        //load datas\n        if (data.msg.topic === \"load_triggers_list\") {\n\n            //input options \"rooms\"\n            var rooms_list = data.msg.rooms_list\n            var rooms = '<select class=\"fullDiv center\" name=\"room\">';\n            rooms += '<option selected disabled>Choisir...</option>';\n            $.each(rooms_list, function(key, value){\n                rooms += '<option value=\"' + value.rooms_list._id + '\">' + value.rooms_list.name + '</option>';\n            });\n            rooms += '<option value=\"deleteme\">SUPPRIMER</option>';\n            rooms += '</select>';\n\n            //input options \"types\"\n            var types = '<select class=\"fullDiv center\" name=\"type\">';\n            types += '<option selected disabled>Choisir...</option>';\n            types += '<option>Visible</option>';\n            types += '<option>Non Visible</option>';\n            types += '</select>';\n\n            //input options \"systems\"\n            var systems = '<select class=\"fullDiv center\" name=\"system\">';\n            systems += '<option selected disabled>Choisir...</option>';\n            if (data.msg.mcp23017_inputs_list.length !== 0) {\n                MCP23017_datas = data.msg.mcp23017_inputs_list;\n                systems += '<option value=\"MCP\">MCP</option>';\n            }\n            if (data.msg.kms868_inputs_list.length !== 0) {\n                KMS868_datas = data.msg.kms868_inputs_list;\n                systems += '<option value=\"KMS\">KMS</option>';\n            }\n            if (data.msg.esp32_inputs_list.length !== 0) {\n                ESP32_datas = data.msg.esp32_inputs_list;\n                systems += '<option value=\"ESP\">ESP</option>';\n            }\n            systems += '</select>';\n\n            //input options \"devices\"\n            var devices = '<select class=\"fullDiv center\" name=\"device\" style=\"display:none;\"\">';\n            devices += '</select>';\n\n            //input options \"entries\"\n            var entries = '<select class=\"fullDiv center\" name=\"entry\" style=\"display:none;\"\">';\n            entries += '</select>';\n\n            if(dat.length !== 0) {\n                dat.forEach(function(obj) {\n                    var tr = document.createElement('tr');\n                    tr.setAttribute('name', 'trigger'); //to delete the data on load\n                    tr.innerHTML =\n                        '<td class=\"center\"><input class=\"fullDiv center\" name=\"name\" autocomplete=\"off\" placeholder=\"Entrer un nom\">' + name + '</input></td>' +\n                        '<td class=\"center\" onchange=\"deleteRoomIn(this)\">' + rooms + '</td>' +\n                        '<td class=\"center\">' + types + '</td>' +\n                        '<td class=\"center\" onchange=\"beforeLoadTriggerDevices(this)\">' + systems + '</td>' +\n                        '<td class=\"center\" onchange=\"beforeLoadTriggerEntries(this)\">' + devices + '</td>' +\n                        '<td class=\"center\">' + entries + '</td>' +\n                        '<td class=\"center\">' +\n                        '<button class=\"btn btn-warning\" onclick=\"editTrigger(this, \\'' + obj._id + '\\')\"><i class=\"fa fa-pencil\"></i></button>' +\n                        '<button class=\"btn btn-danger\" onclick=\"deleteTrigger(\\'' + obj._id + '\\')\"><i class=\"fa fa-trash\"></i></button>' +\n                        '<button class=\"btn btn-danger\" onclick=\"cancelAddTrigger()\"><i class=\"fa fa-refresh\"></i></button>' +\n                        '</td>';\n                    \n                    table.appendChild(tr);\n                    \n                    var sel = table.rows[table.rows.length-1];\n                    $(sel).find('[name=\"name\"]').val(obj.name);\n                    $(sel).find('[name=\"room\"]').val(obj.room);\n                    $(sel).find('[name=\"type\"]').val(obj.type);\n                    $(sel).find('[name=\"system\"]').val(obj.system);\n                    loadTriggerDevices(sel);\n                    $(sel).find('[name=\"device\"]').val(obj.device);\n                    //$(sel).find('[name=\"entry\"]').val(obj.entry);\n                    loadTriggerEntries(sel, obj.entry);\n                    $(sel).find('[name=\"entry\"]').val(obj.entry);\n                });\n            }\n\n            //create last row\n            var tr = document.createElement('tr');\n            tr.setAttribute('name', 'trigger'); //to delete the data on load\n            tr.innerHTML =\n                '<td class=\"center\"><input class=\"fullDiv center\" name=\"name\" autocomplete=\"off\" placeholder=\"Entrer un nom\"></input></td>' +\n                '<td class=\"center\" onchange=\"deleteRoomIn(this)\">' + rooms + '</td>' +\n                '<td class=\"center\">' + types + '</td>' +\n                '<td class=\"center\" onchange=\"beforeLoadTriggerDevices(this)\">' + systems + '</td>' +\n                '<td class=\"center\" onchange=\"beforeLoadTriggerEntries(this)\">' + devices + '</td>' +\n                '<td class=\"center\">' + entries + '</td>' +\n                '<td class=\"center\">' +\n                '<button class=\"btn btn-warning\" onclick=\"addTrigger(this)\"><i class=\"fa fa-check\"></i></button>' +\n                '<button class=\"btn btn-danger\" onclick=\"cancelAddTrigger()\"><i class=\"fa fa-refresh\"></i></button>' +\n                '</td>';\n            \n            table.appendChild(tr);\n        }\n    });\n\n    //Delete Room\n    function deleteRoomIn(data) {\n        var row = data.closest(\"tr\"); // Find the row\n        var room = $(row).find('[name=\"room\"]').val(); //Find the system value\n        if (room === \"deleteme\") {\n            $(row).find('[name=\"room\"]').val(\"Choisir...\");\n        }\n    }\n\n    //Function before load device options\n    function beforeLoadTriggerDevices(data) {\n        var row = data.closest(\"tr\"); // Find the row\n        loadTriggerDevices(row);\n    }\n\n    //Function to load device options\n    function loadTriggerDevices(row) {\n        var system = $(row).find('[name=\"system\"]').val(); //Find the system value\n\n        if (system === \"MCP\") {\n            option_Selected = MCP23017_datas;\n        }\n        else if (system === \"KMS\") {\n            option_Selected = KMS868_datas;\n        }\n        else if (system === \"ESP\") {\n            option_Selected = ESP32_datas;\n        }\n        \n        $(row).find('[name=\"device\"]')\n            .find('option')\n            .remove()\n            .end()\n        $.each(option_Selected, function(id, dev) {\n            $(row).find('[name=\"device\"]')\n                .append(\n                $(\"<option></option>\")\n                    .attr(\"value\", dev.device)\n                    .text(dev.name)\n                )\n        });\n        $(row).find('[name=\"device\"]')\n            .prepend('<option selected disabled>Choisir...</option>')\n        $(row).find('[name=\"device\"]').show();\n    }\n\n    //Function before load entry options\n    function beforeLoadTriggerEntries(data) {\n        var row = data.closest(\"tr\"); // Find the row\n        loadTriggerEntries(row, null);\n        \n    }\n\n    //Function to load entry options\n    function loadTriggerEntries(row, data) {\n        var device = $(row).find('[name=\"device\"]').val(); //Find the device value\n        \n        $(row).find('[name=\"entry\"]')\n            .find('option')\n            .remove()\n            .end()\n        $.each(option_Selected, function(id, dev) {\n            if (device === dev.device) {\n                var entries = dev.entry;\n                $.each(entries, function(id, entry) {\n                    if (entry.disabled && entry.value === data) {\n                        $(row).find('[name=\"entry\"]')\n                        .append(\n                        $(\"<option></option>\")\n                            .attr(\"value\", entry.value)\n                            .text(entry.name)\n                        )\n                    }\n                    else if (!entry.disabled) {\n                        $(row).find('[name=\"entry\"]')\n                        .append(\n                        $(\"<option></option>\")\n                            .attr(\"value\", entry.value)\n                            .text(entry.name)\n                        )\n                    }\n                    else {\n                        $(row).find('[name=\"entry\"]')\n                        .append(\n                        $(\"<option disabled></option>\")\n                            .attr(\"value\", entry.value)\n                            .text(entry.name)\n                        )\n                    }\n                });\n            }\n        });\n        $(row).find('[name=\"entry\"]')\n            .prepend('<option selected disabled>Choisir...</option>')\n        $(row).find('[name=\"entry\"]').show();\n    }\n\n\n    //CLEAR ALL LINES OF THE TABLE\n    function clearTriggersList() {\n        var triggers = document.querySelectorAll('[name = \"trigger\"]');\n        triggers.forEach(trigger => {\n            trigger.remove();\n        });\n    }\n\n    //ADD FUNCTION\n    function addTrigger(data) {\n        var row = data.closest(\"tr\"); // Find the row\n        var name = $(row).find('[name=\"name\"]').val();\n        var room = $(row).find('[name=\"room\"]').val();\n        var type = $(row).find('[name=\"type\"]').val();\n        var system = $(row).find('[name=\"system\"]').val();\n        var device = $(row).find('[name=\"device\"]').val();\n        var entry = $(row).find('[name=\"entry\"]').val();\n        var msg = {\n            \"topic\": \"add_trigger\",\n            \"payload\": {\n                \"name\": name,\n                \"room\": room,\n                \"type\": type,\n                \"system\": system,\n                \"device\": device,\n                \"entry\": entry\n            }\n        }\n        $node.trigger('send', msg)\n    }\n\n    //EDIT FUNCTION\n    function editTrigger(data, id) {\n        var row = data.closest(\"tr\"); // Find the row\n        var name = $(row).find('[name=\"name\"]').val();\n        var room = $(row).find('[name=\"room\"]').val();\n        var type = $(row).find('[name=\"type\"]').val();\n        var system = $(row).find('[name=\"system\"]').val();\n        var device = $(row).find('[name=\"device\"]').val();\n        var entry = $(row).find('[name=\"entry\"]').val();\n        var msg = {\n            \"topic\": \"edit_trigger\",\n            \"payload\": {\n                \"_id\": id,\n                \"name\": name,\n                \"room\": room,\n                \"type\": type,\n                \"system\": system,\n                \"device\": device,\n                \"entry\": entry\n            }\n        }\n        $node.trigger('send', msg)\n    }\n\n    //DELETE FUNCTION\n    function deleteTrigger(data) {\n        triggers_list_modal.style.display = \"block\";\n        document.getElementById('triggers_list_modal_title').innerHTML = \"MISE EN GARDE\";\n        document.getElementById('triggers_list_modal_info').innerHTML = \"Cette action est irréversible. Le déclencheur sera définitivement supprimé...\";\n        messageTriggersList = {\n            \"topic\": \"delete_trigger\",\n            \"payload\": {\n                \"_id\" : data\n            }\n        }\n    }\n    \n    //RELOAD ALL THE DATAS\n    function cancelAddTrigger() {\n        $node.trigger('send', {\"topic\": \"reload_triggers_list\"})\n    }\n\n    // Set variable to record msg.payload\n    var messageTriggersList;\n\n    // Get the modal\n    var triggers_list_modal = document.getElementById('triggers_list_modal');\n        \n    function triggersListModalValidate() {\n        $node.trigger('send', messageTriggersList);\n        triggers_list_modal.style.display = \"none\";\n    }\n\n    function triggersListModalCancelled() {\n        triggers_list_modal.style.display = \"none\";\n    }\n</script>",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": false,
        "templateScope": "local",
        "topicPattern": "",
        "access": "5",
        "accessBehavior": "hide",
