    {
        "id": "9d4a2dab5409fb06",
        "type": "ur_template",
        "z": "b87f87d6b87a22c5",
        "g": "2397660807b5116c",
        "tab": "7d7fae418ec6ebd9",
        "name": "Esp32s List Table",
        "order": 4,
        "width": 12,
        "height": 0,
        "format": "<h3 style=\"text-align:center;\">Liste des ESP</h3>\n\n<div style=\"display: block; text-align: center;\">\n    <label for=\"esp_enabled\" style=\"font-size : 1rem; font-weight: bold; text-decoration: underline; margin-right: 10%;\">ACTIVER</label>\n    <label class=\"switch\">\n        <input type=\"checkbox\" id=\"esp_enabled\" onchange=\"enableESP()\">\n        <span class=\"slider round\"></span>\n    </label>\n</div>\n\n<table id=\"esp32s_list\">\n    <tbody>\n        <tr>\n            <th class=\"center\" style=\"width:5%\">#</th>\n            <th class=\"center\" style=\"width:35%\">Identifiant du module</th>\n            <th class=\"center\" style=\"width:20%\">Nombre d'entrées</th>\n            <th class=\"center\" style=\"width:20%\">Nombre de sorties</th>\n            <th class=\"center\" style=\"width:20%\">Nombre de RFID</th>\n            <th class=\"center\" style=\"width:20%\">Actions</th>\n        </tr>\n    </tbody>\n</table>\n\n<!-- The Modal -->\n<div id=\"esp32s_list_modal\" class=\"modal\">\n    <!-- Modal content -->\n    <div class=\"modal-content\">\n        <div class=\"modal-header\">\n            <h2 id=\"esp32s_list_modal_title\" style=\"margin: auto;\"></h2>\n        </div>\n        <div class=\"modal-body\">\n            <p id=\"esp32s_list_modal_info\"></p>\n            <p>Voulez-vous continuer ?</p>\n        </div>\n        <div class=\"modal-footer\">\n            <div class=\"d-grid gap-2 col-12 mx-auto\">\n                <button type=\"button\" class=\"btn btn-danger btn-lg\" onclick=\"esp32sListModalValidate()\">Valider</button>\n                <button type=\"button\" class=\"btn btn-secondary btn-lg\" onclick=\"esp32sListModalCancelled()\">Annuler</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n    //GLOBALS VARIABLES\n\n    //GLOBALS FUNCTIONS\n\n    //CREATE TABLE\n    $node.on(\"update-value\", function(evt, data) {\n        var table = document.getElementById('esp32s_list');\n        var enabled = data.msg.payload[0].ESP32.esp_enabled;\n        $('#esp_enabled').prop(\"checked\", enabled);\n        $('#esp_enabled').prop(\"disabled\", false);\n        var index = 0;\n        //clear table\n        clearEsp32sList();\n\n        //load datas\n        if (data.msg.topic === \"load_esp32s_list\") {\n            dat = data.msg.payload[0].ESP32.devices;\n            if (dat !== undefined) {\n                dat.forEach(function(obj) {\n                    index++;\n                    var tr = document.createElement('tr');\n                    tr.setAttribute('name', 'esp32'); //to delete the data on load\n                    tr.setAttribute('id', obj._id); //to reorder the table\n                    tr.innerHTML =\n                        '<td name=\"number\" class=\"center\">' + index + '</td>' +\n                        '<td class=\"center\"><input name=\"device\" class=\"fullDiv center\" value=\"' + obj.device + '\" autocomplete=\"off\" placeholder=\"Identifiant du module\"></input></td>' +\n                        '<td class=\"center\"><input name=\"number_input\" class=\"fullDiv center\" value=\"' + obj.number_input + '\" autocomplete=\"off\" placeholder=\"Nombre d\\'entrées\"></input></td>' +\n                        '<td class=\"center\"><input name=\"number_output\" class=\"fullDiv center\" value=\"' + obj.number_output + '\" autocomplete=\"off\" placeholder=\"Nombre de sorties\"></input></td>' +\n                        '<td class=\"center\"><input name=\"number_rfid\" class=\"fullDiv center\" value=\"' + obj.number_rfid + '\" autocomplete=\"off\" placeholder=\"Nombre de RFID\"></input></td>' +\n                        '<td class=\"center\">' +\n                        '<button class=\"btn btn-warning\" onclick=\"editEsp32(this, \\'' + obj._id + '\\')\"><i class=\"fa fa-pencil\"></i></button>' +\n                        '<button class=\"btn btn-danger\" onclick=\"deleteEsp32(this, \\'' + obj._id + '\\')\"><i class=\"fa fa-trash\"></i></button>' +\n                        '</td>';\n                    table.appendChild(tr);\n                });\n            }\n        }\n\n        //create last row\n        var tr = document.createElement('tr');\n        tr.setAttribute('name', 'esp32'); //to delete the data on load\n        tr.setAttribute('id', \"newAction\"); //to reorder the table\n        tr.innerHTML =\n            '<td name=\"number\" class=\"center\">' + (index+1) + '</td>' +\n            '<td class=\"center\"><input name=\"device\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Identifiant du module\"></input></td>' +\n            '<td class=\"center\"><input name=\"number_input\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Nombre d\\'entrées\"></input></td>' +\n            '<td class=\"center\"><input name=\"number_output\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Nombre de sorties\"></input></td>' +\n            '<td class=\"center\"><input name=\"number_rfid\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Nombre de RFID\"></input></td>' +\n            '<td class=\"center\">' +\n            '<button class=\"btn btn-warning\" onclick=\"addEsp32(this)\"><i class=\"fa fa-save\"></i></button>' +\n            '<button class=\"btn btn-danger\" onclick=\"cancelAddEsp32()\"><i class=\"fa fa-refresh\"></i></button>' +\n            '</td>';\n        table.appendChild(tr);\n    });\n\n    //CLEAR ALL LINES OF THE TABLE\n    function clearEsp32sList() {\n        var esp32s = document.querySelectorAll('[name = \"esp32\"]');\n        esp32s.forEach(esp32 => {\n            esp32.remove();\n        });\n    }\n\n    //ENABLE ESP\n    function enableESP() {\n        var enabled = $('#esp_enabled').is(\":checked\");\n        var msg = {\n            \"topic\": \"enabled_esp_config\",\n            \"payload\": {\n                \"enabled\": enabled\n            }\n        }\n        $node.trigger('send', msg);\n    }\n\n    //ADD FUNCTION\n    function addEsp32(data) {\n        var row = data.closest(\"tr\"); // Find the row\n        var device = $(row).find('[name=\"device\"]').val();\n        var number_input = $(row).find('[name=\"number_input\"]').val();\n        var number_output = $(row).find('[name=\"number_output\"]').val();\n        var number_rfid = $(row).find('[name=\"number_rfid\"]').val();\n        var msg = {\n            \"topic\": \"add_esp32\",\n            \"payload\": {\n                \"device\": device,\n                \"number_input\": number_input,\n                \"number_output\": number_output,\n                \"number_rfid\": number_rfid,\n            }\n        }\n        $node.trigger('send', msg)\n    }\n\n    //EDIT FUNCTION\n    function editEsp32(data, id) {\n        var row = data.closest(\"tr\"); // Find the row\n        var device = $(row).find('[name=\"device\"]').val();\n        var number_input = $(row).find('[name=\"number_input\"]').val();\n        var number_output = $(row).find('[name=\"number_output\"]').val();\n        var number_rfid = $(row).find('[name=\"number_rfid\"]').val();\n        var msg = {\n            \"topic\": \"edit_esp32\",\n            \"payload\": {\n                \"_id\": id,\n                \"device\": device,\n                \"number_input\": number_input,\n                \"number_output\": number_output,\n                \"number_rfid\": number_rfid,\n            }\n        }\n        $node.trigger('send', msg);\n    }\n\n    //CANCEL ADD\n    function cancelAddEsp32(data) {\n        var msg = {\n            \"topic\": \"reload_esp32\",\n            \"payload\": {\n            }\n        }\n        $node.trigger('send', msg);\n    }\n\n    //DELETE FUNCTION\n    function deleteEsp32(data, id) {\n        var row = data.closest(\"tr\"); // Find the row\n        var device = $(row).find('[name=\"device\"]').val();\n        esp32s_list_modal.style.display = \"block\";\n        document.getElementById('esp32s_list_modal_title').innerHTML = \"MISE EN GARDE\";\n        document.getElementById('esp32s_list_modal_info').innerHTML = \"Cette action est irréversible. L'ESP sera définitivement supprimée...\";\n        messageEsp32s = {\n            \"topic\": \"delete_esp32\",\n            \"payload\": {\n                \"_id\" : id,\n                \"device\": device,\n            }\n        }\n    }\n\n    // Set variable to record msg.payload\n    var messageEsp32s;\n\n    // Get the modal\n    var esp32s_list_modal = document.getElementById('esp32s_list_modal');\n        \n    function esp32sListModalValidate() {\n        $node.trigger('send', messageEsp32s);\n        esp32s_list_modal.style.display = \"none\";\n    }\n\n    function esp32sListModalCancelled() {\n        esp32s_list_modal.style.display = \"none\";\n    }\n\n</script>\n",
