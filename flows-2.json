    {
        "id": "0689930339b7e921",
        "type": "function",
        "z": "b87f87d6b87a22c5",
        "g": "0ea444d24736682e",
        "name": "Convert",
        "func": "//for MCP23017\nvar MCP23017 = msg.payload[0].MCP23017;\nvar mcp23017_inputs_list = [];\n\n//for KMS868\nvar KMS868 = msg.payload[0].KMS868;\nvar kms868_inputs_list = [];\n\n//for ESP32\nvar ESP32 = msg.payload[0].ESP32;\nvar esp32_inputs_list = [];\n\nmsg.payload = msg.payload[0].inputs || [];\n\n//make MCP23017 list\nif (MCP23017.mcp_enabled) {\n    var mcp_devices = [\n        { name: \"mcp32\", enabled: MCP23017.mcp32.enabled, value_A: MCP23017.mcp32.value_A, value_B: MCP23017.mcp32.value_B },\n        { name: \"mcp33\", enabled: MCP23017.mcp33.enabled, value_A: MCP23017.mcp33.value_A, value_B: MCP23017.mcp33.value_B },\n        { name: \"mcp34\", enabled: MCP23017.mcp34.enabled, value_A: MCP23017.mcp34.value_A, value_B: MCP23017.mcp34.value_B },\n        { name: \"mcp35\", enabled: MCP23017.mcp35.enabled, value_A: MCP23017.mcp35.value_A, value_B: MCP23017.mcp35.value_B },\n        { name: \"mcp36\", enabled: MCP23017.mcp36.enabled, value_A: MCP23017.mcp36.value_A, value_B: MCP23017.mcp36.value_B },\n        { name: \"mcp37\", enabled: MCP23017.mcp37.enabled, value_A: MCP23017.mcp37.value_A, value_B: MCP23017.mcp37.value_B },\n        { name: \"mcp38\", enabled: MCP23017.mcp38.enabled, value_A: MCP23017.mcp38.value_A, value_B: MCP23017.mcp38.value_B },\n        { name: \"mcp39\", enabled: MCP23017.mcp39.enabled, value_A: MCP23017.mcp39.value_A, value_B: MCP23017.mcp39.value_B }\n    ]\n    for (var a = 0; a < 8; a++) {\n        if (mcp_devices[a].enabled) {\n            var mcp_device = mcp_devices[a].name;\n            var inputs = [];\n            for (var i = 1; i < 9; i++) {\n                var input = true;\n                if (mcp_devices[a].value_A === \"Input\") {\n                    for (var y = 0; y < msg.payload.length; y++) {\n                        if (msg.payload[y].device === mcp_device && msg.payload[y].entry === \"channel_\" + i) {\n                            input = false;\n                        }\n                    }\n                    if (input) {\n                        inputs.push({\n                            \"name\": \"channel_\" + i,\n                            \"value\": \"channel_\" + i,\n                            \"disabled\": false,\n                        })\n                    }\n                    else {\n                        inputs.push({\n                            \"name\": \"channel_\" + i,\n                            \"value\": \"channel_\" + i,\n                            \"disabled\": true,\n                        })\n                    }\n                }\n            }\n            for (var i = 9; i < 17; i++) {\n                var input = true;\n                if (mcp_devices[a].value_B === \"Input\") {\n                    for (var y = 0; y < msg.payload.length; y++) {\n                        if (msg.payload[y].device === mcp_device && msg.payload[y].entry === \"channel_\" + i) {\n                            input = false;\n                        }\n                    }\n                    if (input) {\n                        inputs.push({\n                            \"name\": \"channel_\" + i,\n                            \"value\": \"channel_\" + i,\n                            \"disabled\": false,\n                        })\n                    }\n                    else {\n                        inputs.push({\n                            \"name\": \"channel_\" + i,\n                            \"value\": \"channel_\" + i,\n                            \"disabled\": true,\n                        })\n                    }\n                }\n            }\n            mcp23017_inputs_list.push({\n                \"device\": mcp_device,\n                \"name\": mcp_device.toUpperCase(),\n                \"entry\": inputs\n            })\n        }\n    }\n}\nmsg.mcp23017_inputs_list = mcp23017_inputs_list;\n\n//make KMS868 list\nif (KMS868.kms_enabled) {\n    KMS868 = KMS868.devices;\n    for (var a = 0; a<KMS868.length; a++) {\n        var inputs = [];\n        var device = KMS868[a]._id;\n        for (var i = 1; i < 17; i++) {\n            var input = true;\n            for (var y = 0; y < msg.payload.length; y++) {\n                if (msg.payload[y].device === device && msg.payload[y].entry === \"input\" + i) {\n                    input = false;\n                }\n            }\n            if (input) {\n                inputs.push({\n                    \"name\": \"channel_\" + i,\n                    \"value\": \"input\" + i,\n                    \"disabled\": false,\n                })\n            }\n            else {\n                inputs.push({\n                    \"name\": \"channel_\" + i,\n                    \"value\": \"input\" + i,\n                    \"disabled\": true,\n                })\n            }\n        }\n        kms868_inputs_list.push({\n            \"device\": KMS868[a]._id,\n            \"name\": KMS868[a].name,\n            \"entry\": inputs\n        })\n    }\n}\nmsg.kms868_inputs_list = kms868_inputs_list;\n\n//make ESP32 list\nif (ESP32.esp_enabled) {\n    ESP32 = ESP32.devices;\n    for (var a = 0; a < ESP32.length; a++) {\n        var device = ESP32[a]._id;\n\n        var inputs = [];\n        var lengthESP32_inputs = +ESP32[a].number_input + 1;\n        if (lengthESP32_inputs > 1) {\n            for (var i = 1; i < lengthESP32_inputs; i++) {\n                var input = true;\n                for (var y = 0; y < msg.payload.length; y++) {\n                    if (msg.payload[y].device === device && msg.payload[y].entry === \"input\" + i) {\n                        input = false;\n                    }\n                }\n                if (input) {\n                    inputs.push({\n                        \"name\": \"entrée_\" + i,\n                        \"value\": \"input\" + i,\n                        \"disabled\": false,\n                    })\n                }\n                else {\n                    inputs.push({\n                        \"name\": \"entrée_\" + i,\n                        \"value\": \"input\" + i,\n                        \"disabled\": true,\n                    })\n                }\n            }\n            /*esp32_inputs_list.push({\n                \"device\": ESP32[a]._id,\n                \"name\": ESP32[a].device,\n                \"entry\": inputs\n            })*/\n        }\n\n        var rfids = [];\n        var lengthESP32_rfid = +ESP32[a].number_rfid + 1;\n        if (lengthESP32_rfid > 1) {\n            for (var i = 1; i < lengthESP32_rfid; i++) {\n                var rfid = true;\n                for (var y = 0; y < msg.payload.length; y++) {\n                    if (msg.payload[y].device === device && msg.payload[y].entry === \"rfid\" + i) {\n                        rfid = false;\n                    }\n                }\n                if (rfid) {\n                    rfids.push({\n                        \"name\": \"rfid_\" + i,\n                        \"value\": \"rfid\" + i,\n                        \"disabled\": false,\n                    })\n                }\n                else {\n                    rfids.push({\n                        \"name\": \"rfid_\" + i,\n                        \"value\": \"rfid\" + i,\n                        \"disabled\": true,\n                    })\n                }\n            }\n            /*esp32_inputs_list.push({\n                \"device\": ESP32[a]._id,\n                \"name\": ESP32[a].device,\n                \"entry\": inputs\n            })*/\n        }\n\n        const all_inputs = inputs.concat(rfids);\n        if (all_inputs.length > 0) {\n            esp32_inputs_list.push({\n                \"device\": ESP32[a]._id,\n                \"name\": ESP32[a].device,\n                \"entry\": all_inputs\n            })\n        }\n    }\n}\nmsg.esp32_inputs_list = esp32_inputs_list;\n\n//msg.esp32_inputs_list = [];\n\nreturn msg;",
