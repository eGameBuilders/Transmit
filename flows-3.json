        "tab": "ff49800a9359b74c",
        "name": "KMS868",
        "order": 4,
        "width": 12,
        "height": 0,
        "format": "<!--\n// =========================================================================\n// 1. VISUEL : STRUCTURE HTML ET FORMULAIRE DES MODULES KMS868\n// =========================================================================\n-->\n<h3 style=\"text-align:center;\">Liste des modules KMS</h3>\n\n<div style=\"display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 15px;\">\n    <span style=\"font-size: 1rem; font-weight: bold; text-decoration: underline;\">ACTIVER</span>\n\n    <!-- ANCHOR : STRUCTURE DE BOÎTES DE VOTRE V3 DU KEYPAD POUR LE COMMUTATEUR GÉNÉRAL KMS -->\n    <div id=\"kms_enabled_bg\" onclick=\"toggleKmsEnabledPill()\" class=\"btn btn-dark switch\"\n        id=\"global_kms_switch_wrapper\">\n        <div id=\"kms_enabled_circle\" class=\"switchcircle\"></div>\n    </div>\n</div>\n\n<table id=\"kms868s_list\">\n    <tbody>\n        <tr>\n            <th class=\"center\" style=\"width:5%\">#</th>\n            <th class=\"center\" style=\"width:40%\">Nom du module</th>\n            <th class=\"center\" style=\"width:35%\">Identifiant du module</th>\n            <th class=\"center\" style=\"width:20%\">Actions</th>\n        </tr>\n    </tbody>\n</table>\n\n<!-- MODALE SYSTEME -->\n<div id=\"kms868s_list_modal\" class=\"modal\">\n    <!-- Modal content -->\n    <div class=\"modal-content\">\n        <div class=\"modal-header\">\n            <h2 id=\"kms868s_list_modal_title\" style=\"margin: auto;\"></h2>\n        </div>\n        <div class=\"modal-body\">\n            <p id=\"kms868s_list_modal_info\"></p>\n            <p id=\"kms868s_list_modal_question\">Voulez-vous continuer ?</p>\n        </div>\n        <div class=\"modal-footer\" id=\"kms_modal_buttons_container\">\n            <div class=\"d-grid gap-2 col-12 mx-auto\">\n                <button type=\"button\" class=\"btn btn-danger btn-lg\" onclick=\"kms868sListModalValidate()\">Valider</button>\n                <button type=\"button\" class=\"btn btn-secondary btn-lg\" onclick=\"kms868sListModalCancelled()\">Annuler</button>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    // =========================================================================\n// 2. RECEPTION : EXTRACTION VANILLA JS ET RENDU DYNAMIQUE DES LIGNES\n// =========================================================================\n    // VARIABLES GLOBALES\n    var messageKms868s;\n    var kms868s_list_modal = document.getElementById('kms868s_list_modal');\n    \n    // REGISTRES BOOLÉENS SÉCURISÉS POUR SIMULER LES INPUTS EN JAVASCRIPT PUR\n    var isKmsGlobalEnabled = false;\n    var isKmsGlobalLocked = false;\n\n    $node.on(\"update-value\", function(evt, data) {\n        if (data && data.msg && data.msg.topic === \"load_kms868s_list\") {\n            // EXTRACTION DU PREMIER ÉLÉMENT DU TABLEAU DE RÉSULTATS (LOGIQUE REPLACEROOT VALIDÉE)\n            var payload = (data.msg && Array.isArray(data.msg.payload)) ? data.msg.payload[0] : null;\n            if (!payload) return;\n\n            var table = document.getElementById('kms868s_list');\n            \n            isKmsGlobalEnabled = !!payload.kms_enabled;\n            refreshKmsGlobalVisual();\n\n            // NETTOYAGE PRÉALABLE DU TABLEAU\n            clearKms868sList();\n\n            var dat = payload.devices || [];\n            var index = 0;\n            var isAnyKmsInUse = false;\n\n            // CHARGEMENT DE LA BOUCLE DYNAMIQUE DES CARTES ENREGISTRÉES\n            dat.forEach(function(obj) {\n                if (!obj) return;\n                index++;\n                if (obj.inuse) {\n                    isAnyKmsInUse = true;\n                }\n\n                var tr = document.createElement('tr');\n                tr.setAttribute('name', 'kms868');\n                tr.setAttribute('id', obj._id);\n                \n                // SÉCURITÉ MATÉRIELLE : BLOCAGE DE LA SUPPRESSION S'IL EST ASSOCIÉ À UN MÉCANISME\n                var dataInUseAttr = obj.inuse ? 'data-inuse=\"true\"' : 'data-inuse=\"false\"';\n                var titleAlert = obj.inuse ? 'title=\"Ce module est associé à un mécanisme actif et ne peut pas être supprimé\"' : '';\n\n                tr.innerHTML =\n                    '<td name=\"number\" class=\"center\">' + index + '</td>' +\n                    '<td class=\"center\"><input name=\"name\" class=\"fullDiv center\" value=\"' + (obj.name || '') + '\" autocomplete=\"off\" placeholder=\"Nom du module\"></input></td>' +\n                    '<td class=\"center\"><input name=\"device\" class=\"fullDiv center\" value=\"' + (obj.device || '') + '\" autocomplete=\"off\" placeholder=\"Identifiant du module\"></input></td>' +\n                    '<td class=\"center\">' +\n                    '<button class=\"btn btn-dark\" onclick=\"editKms868(this, \\'' + obj._id + '\\')\"><i class=\"nav-hdr-btn ti-save fa-lg\"></i></button>' +\n                    '<button class=\"btn btn-danger\" ' + titleAlert + ' ' + dataInUseAttr + ' onclick=\"deleteKms868(\\'' + obj._id + '\\', this)\"><i class=\"nav-hdr-btn ti-trash fa-lg\"></i></button>' +\n                    '</td>';\n                table.appendChild(tr);\n            });\n\n            // APPLICATION DE LA SÉCURITÉ SUR LE BOUTON GÉNÉRAL D'ACTIVATION\n            var wrapper = document.getElementById('global_kms_switch_wrapper');\n            var globalBg = document.getElementById('kms_enabled_bg');\n            \n            if (isAnyKmsInUse) {\n                isKmsGlobalLocked = true;\n                if (globalBg) globalBg.classList.add('pe-none', 'opacity-50');\n                if (wrapper) wrapper.setAttribute('title', 'Modification impossible : un ou plusieurs modules KMS sont requis par le scénario matériel');\n            } else {\n                isKmsGlobalLocked = false;\n                if (globalBg) globalBg.classList.remove('pe-none', 'opacity-50');\n                if (wrapper) wrapper.removeAttribute('title');\n            }\n\n            // CRÉATION DE LA LIGNE D'AJOUT EN BAS DU TABLEAU\n            var trNew = document.createElement('tr');\n            trNew.setAttribute('name', 'kms868');\n            trNew.setAttribute('id', \"newAction\");\n            trNew.innerHTML =\n                '<td name=\"number\" class=\"center\">' + (index + 1) + '</td>' +\n                '<td class=\"center\"><input name=\"name\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Nom du module\"></input></td>' +\n                '<td class=\"center\"><input name=\"device\" class=\"fullDiv center\" autocomplete=\"off\" placeholder=\"Identifiant du module\"></input></td>' +\n                '<td class=\"center\">' +\n                '<button class=\"btn btn-warning\" onclick=\"addKms868(this)\"><i class=\"nav-hdr-btn ti-save fa-lg\"></i></button>' +\n                '<button class=\"btn btn-danger\" onclick=\"cancelAddKms868()\"><i class=\"nav-hdr-btn ti-refresh fa-lg\"></i></button>' +\n                '</td>';\n            table.appendChild(trNew);\n        }\n    });\n\n    // FONCTION DE RAFRAÎCHISSEMENT VISUEL EXCLUSIVE DU COMMUTATEUR GÉNÉRAL KMS V3\n    function refreshKmsGlobalVisual() {\n        var bg = document.getElementById('kms_enabled_bg');\n        var circle = document.getElementById('kms_enabled_circle');\n        if (!bg || !circle) return;\n\n        if (isKmsGlobalEnabled) {\n            bg.classList.remove('btn-dark');\n            bg.classList.add('btn-danger');\n            circle.style.transform = \"translateX(22px)\";\n        } else {\n            bg.classList.remove('btn-danger');\n            bg.classList.add('btn-dark');\n            circle.style.transform = \"translateX(0px)\";\n        }\n    }\n\n    function clearKms868sList() {\n        var kms868s = document.querySelectorAll('[name=\"kms868\"]');\n        var addresses = Array.from(kms868s);\n        addresses.forEach(function(kms868) {\n            kms868.remove();\n        });\n    }\n    // =========================================================================\n// 3. ACTIONS : TRANSMISSION DES COMMANDES ET MODALES AU SERVEUR NODE-RED\n// =========================================================================\n    // INTERCEPTION DE L'ACTION DE CLIC SUR LE COMMUTATEUR GÉNÉRAL KMS SIMULÉ\n    function toggleKmsEnabledPill() {\n        if (isKmsGlobalLocked) return;\n\n        isKmsGlobalEnabled = !isKmsGlobalEnabled;\n        refreshKmsGlobalVisual();\n\n        var msg = {\n            \"topic\": \"enabled_kms_config\",\n            \"payload\": {\n                \"enabled\": isKmsGlobalEnabled\n            }\n        };\n        $node.trigger('send', msg);\n    } \n\n    function addKms868(element) {\n        var row = element.closest(\"tr\");\n        if (!row) return;\n        var nameInput = row.querySelector('[name=\"name\"]');\n        var deviceInput = row.querySelector('[name=\"device\"]');\n        var msg = {\n            \"topic\": \"add_kms868\",\n            \"payload\": {\n                \"name\": nameInput ? nameInput.value : \"\",\n                \"device\": deviceInput ? deviceInput.value : \"\"\n            }\n        };\n        $node.trigger('send', msg);\n    }\n\n    function editKms868(element, id) {\n        var row = element.closest(\"tr\");\n        if (!row) return;\n        var nameInput = row.querySelector('[name=\"name\"]');\n        var deviceInput = row.querySelector('[name=\"device\"]');\n        var msg = {\n            \"topic\": \"edit_kms868\",\n            \"payload\": {\n                \"_id\": id,\n                \"name\": nameInput ? nameInput.value : \"\",\n                \"device\": deviceInput ? deviceInput.value : \"\"\n            }\n        };\n        $node.trigger('send', msg);\n    }\n\n    function deleteKms868(id, element) {\n        var modalTitle = document.getElementById('kms868s_list_modal_title');\n        var modalInfo = document.getElementById('kms868s_list_modal_info');\n        var modalQuestion = document.getElementById('kms868s_list_modal_question');\n        var buttonsContainer = document.getElementById('kms_modal_buttons_container');\n        \n        if (kms868s_list_modal) {\n            kms868s_list_modal.style.display = \"block\";\n        }\n\n        var row = element.closest(\"tr\");\n        var deviceMac = \"\";\n        if (row) {\n            var deviceInput = row.querySelector('[name=\"device\"]');\n            deviceMac = deviceInput ? deviceInput.value : \"\";\n        }\n\n        // RÉCUPÉRATION EN DIRECT DE L'ATTRIBUT INUSE POUSSÉ PAR LE BOUTON\n        var isInUse = element.getAttribute('data-inuse') === \"true\";\n\n        if (isInUse) {\n            // CAS SÉCURITÉ MATÉRIELLE : MODALE D'ALERTE PURE SANS BOUTON VALIDER\n            if (modalTitle) modalTitle.innerHTML = \"ACTION IMPOSSIBLE\";\n            if (modalInfo) modalInfo.innerHTML = \"Suppression impossible : ce module est relié a des mecanismes actifs.\";\n            if (modalQuestion) modalQuestion.style.display = \"none\";\n            \n            // ON MASQUE TOUT LE BLOC DE VALIDATION ET ON MET UN BOUTON DE FERMETURE UNIQUE CENTRÉ\n            if (buttonsContainer) {\n                buttonsContainer.innerHTML = '<div class=\"d-grid gap-2 col-12 mx-auto\"><button type=\"button\" class=\"btn btn-secondary btn-lg\" onclick=\"kms868sListModalCancelled()\">Fermer</button></div>';\n            }\n            messageKms868s = null;\n        } else {\n            // CAS STANDARD : ENTIÈREMENT CONFORME À VOTRE LOGIQUE ET VISUEL D'ORIGINE\n            if (modalTitle) modalTitle.innerHTML = \"MISE EN GARDE\";\n            if (modalInfo) modalInfo.innerHTML = \"Cette action est irréversible. Le KMS sera définitivement supprimé...\";\n            if (modalQuestion) modalQuestion.style.display = \"block\";\n            \n            // ON RÉINJECTE VOS DEUX BOUTONS D'ORIGINE AVEC VOTRE GRILLE BOOTSTRAP EXPLICITE\n            if (buttonsContainer) {\n                buttonsContainer.innerHTML = \n                    '<div class=\"d-grid gap-2 col-12 mx-auto\">' +\n                        '<button type=\"button\" class=\"btn btn-danger btn-lg\" onclick=\"kms868sListModalValidate()\">Valider</button>' +\n                        '<button type=\"button\" class=\"btn btn-secondary btn-lg\" onclick=\"kms868sListModalCancelled()\">Annuler</button>' +\n                    '</div>';\n            }\n            \n            messageKms868s = {\n                \"topic\": \"delete_kms868\",\n                \"payload\": {\n                    \"_id\" : id,\n                    \"device\": deviceMac\n                }\n            };\n        }\n    }\n\n\n    function cancelAddKms868() {\n        var msg = {\n            \"topic\": \"reload_kms868\",\n            \"payload\": {}\n        };\n        $node.trigger('send', msg);\n    }\n        \n    function kms868sListModalValidate() {\n        if (messageKms868s && kms868s_list_modal) {\n            $node.trigger('send', messageKms868s);\n            kms868s_list_modal.style.display = \"none\";\n        }\n    }\n\n    function kms868sListModalCancelled() {\n        if (kms868s_list_modal) {\n            kms868s_list_modal.style.display = \"none\";\n        }\n    }\n</script>\n",
